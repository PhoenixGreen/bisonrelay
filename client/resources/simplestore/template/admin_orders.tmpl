# Orders

{{template "orderfilters.tmpl" .}}

{{if eq (len .Orders) 0 -}}
Nothing here. Try another filter.
{{- else -}}
{{range .Orders}}
{{- /*
An order that wants the seller is drawn as one -- the same treatment the
buyer's own list gives an order that wants them. See orderView.arrange, which
puts these at the top whichever way the rest is sorted.
*/}}
{{if .Wants true -}}
--panel[full=on, padding=12, margin=0 0 8 0, border=2, color=accent, radius=8, badge=Needs you, badgeink=accent]--
{{- else -}}
--panel[full=on, padding=12, margin=0 0 8 0, border=1, color=outline, radius=8]--
{{- end}}
--listing--
title: Order #{{ .ID.Num }} — {{ orderSays .Order }}
link: /admin/order/{{.User}}/{{.ID}}
summary: {{ if .UserNick }}{{ .UserNick }}{{ else }}{{ .User.ShortLogID }}{{ end }} · {{ .PlacedTS.Format "2 Jan 2006, 15:04" }}{{ if .AwaitingSeller }} · waiting on you{{ end }}{{ if .Expired }} · quote lapsed{{ end }}
meta: {{ money .Total }}
button: Open
style: {{ if .Open }}primary{{ else }}plain{{ end }}
--/listing--
--/panel--
{{- end}}
{{- end}}
