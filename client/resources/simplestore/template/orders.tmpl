# Your orders

{{template "orderfilters.tmpl" .}}

{{if eq (len .Orders) 0 -}}
Nothing here. Try another filter, or the shop.
{{- else -}}
{{$seller := .Seller}}
{{range .Orders}}
{{- /*
An order that wants you is drawn as one.

Whatever needs the reader is at the top of the list whichever way the rest is
sorted -- see orderView.arrange -- and this is the other half of that: a row
that looks like every other row is a row nobody picks out of a page, however
high up it is.
*/}}
{{if .Wants $seller -}}
--panel[full=on, padding=12, margin=0 0 8 0, border=2, color=accent, radius=8, badge=Needs you, badgeink=accent]--
--listing--
title: Order #{{.ID.Num}} — {{ orderSays . }}
link: order/{{.ID}}
summary: {{ .PlacedTS.Format "2 Jan 2006" }} · {{ .Lines }} line{{ if ne .Lines 1 }}s{{ end }}{{ if .SellerReplied }} · the seller has replied{{ end }}
meta: {{ money .Total }}
button: {{ if .AwaitingPayment }}Pay it{{ else }}Open{{ end }}
style: primary
--/listing--
--/panel--
{{- else -}}
--panel[full=on, padding=12, margin=0 0 8 0, border=1, color=outline, radius=8]--
--listing--
title: Order #{{.ID.Num}} — {{ orderSays . }}
link: order/{{.ID}}
summary: {{ .PlacedTS.Format "2 Jan 2006" }} · {{ .Lines }} line{{ if ne .Lines 1 }}s{{ end }}{{ if .SellerReplied }} · the seller has replied{{ end }}
meta: {{ money .Total }}
button: {{ if .Open }}Open{{ else }}View{{ end }}
style: {{ if .Open }}primary{{ else }}plain{{ end }}
--/listing--

{{- /*
Put away, not deleted.

There is one copy of an order and it lives in the seller's store -- a buyer
reading this is reading somebody else's records -- and an order's number is
the last one on disk plus one, so removing the newest would hand the next
order a number already used in messages and in the metadata on every file
this shop has sent. See orderlist.go.
*/}}
{{if and (not .Open) (not .Hidden)}}
--form[align=right]--
type="action" value="/hideOrder/{{.ID}}"
type="submit" label="Hide it" confirm="Take order #{{.ID.Num}} off your list? It stays under Called off, and nothing about it changes."
--/form--
{{end}}
--/panel--
{{- end}}
{{- end}}
{{- end}}
