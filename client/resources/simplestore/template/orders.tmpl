{{- else -}}
{{range .Orders}}
--panel[padding=12, margin=0 0 8 0, border=1, color=outline, radius=8]--
--listing--
title: Order #{{.ID.Num}} — {{ orderStatus .Status }}
link: order/{{.ID}}
summary: {{ .PlacedTS.Format "2 Jan 2006" }} · {{ .Lines }} line{{ if ne .Lines 1 }}s{{ end }}{{ if .SellerReplied }} · the seller has replied{{ end }}{{ if .Expired }} · the quoted amount has lapsed{{ end }}
meta: {{ money .Total }}
button: {{ if .AwaitingPayment }}Pay{{ else }}View{{ end }}
style: {{ if .Open }}primary{{ else }}plain{{ end }}
--/listing--
--/panel--
{{- end}}
{{- end}}
