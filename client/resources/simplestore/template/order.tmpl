# Order #{{.ID.Num}}

**{{ orderStatus .Status }}** · placed {{ .PlacedTS.Format "2 Jan 2006, 15:04" }}

{{if .PayURI -}}
--panel[padding=16, margin=0 0 16 0, border=1, color=accent, radius=8]--
## Pay {{ money .Total }}{{ with .TotalDCR }} — {{ . }}{{ end }}

{{ .PayURI }}

{{ if .ExpiresIn }}That amount holds for another {{ .ExpiresIn }}, after which the rate is worked out again.{{ else }}The quoted amount has lapsed. Ask the seller below and they can place it again at today's rate.{{ end }}
--/panel--
{{ else if .Expired -}}
--panel[padding=16, margin=0 0 16 0, border=1, color=outline, radius=8]--
The amount this order was quoted at no longer holds. Ask the seller below
and they can place it again at today's rate.
--/panel--
{{ end -}}

--panel[padding=12, border=1, color=outline, radius=8]--
{{range .Cart.Items}}
--listing--
title: {{ .Product.Title }}
summary: {{ .Quantity }} × {{ money .Product.Price }}
meta: {{ money .Total }}
{{ with productImage .Product.Image }}image: {{.}}
{{ end -}}
--/listing--
{{end}}
**Total: {{ money .Total }}**{{ if gt .ShipCharge 0.0 }} (including {{ money .ShipCharge }} shipping){{ end }}
--/panel--

{{if .AwaitingPayment -}}
--form[align=left]--
type="action" value="/cancelOrder/{{.ID}}"
type="submit" label="Call this order off" style="danger" confirm="Call off order #{{ .ID.Num }}? Nothing has been charged, and the seller is told. You would have to order again."
--/form--

{{ end -}}
{{if .ShipAddr -}}
