{{.ShipAddr.Address2}}
{{- end}}
{{.ShipAddr.City}}, {{.ShipAddr.State}}, {{.ShipAddr.PostalCode}}
{{- if .ShipAddr.Phone}}
{{.ShipAddr.Phone}}
{{- end}}

{{end -}}
