{{range .Items}}
--panel[padding=12, margin=0 0 8 0, border=1, color=outline, radius=8]--
**{{.Product.Title}}** — {{ money .Product.Price }} each

{{ .Quantity }} × {{ money .Product.Price }} = **{{ money .Total }}**

--form--
type="action" value="/setCartQty"
type="hidden" name="sku" value="{{.Product.SKU}}"
type="intinput" label="Quantity" name="qty" value="{{.Quantity}}"
type="submit" label="Update"
--/form--

--form--
type="action" value="/removeFromCart"
type="hidden" name="sku" value="{{.Product.SKU}}"
type="submit" label="Remove"
--/form--
--/panel--
{{- end}}
