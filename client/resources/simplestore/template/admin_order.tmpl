{{- else -}}
{{range .Order.Comments}}
--panel[padding=10, margin=0 0 6 0, radius=8, fill={{ if .FromAdmin }}quoteBar{{ else }}raised{{ end }}, justify={{ if .FromAdmin }}right{{ else }}left{{ end }}]--
