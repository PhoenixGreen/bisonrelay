{{ if .Order.Open -}}
## Move it on

{{ if eq .Order.Status "placed" }}
--form[align=left]--
type="action" value="/admin/orderstatusto/{{.Order.User}}/{{.Order.ID}}/shipped"
type="submit" label="Mark as shipped" style="primary" confirm="Mark order #{{ .Order.ID.Num }} as shipped? The buyer is told."
--/form--
{{ end }}
{{ if eq .Order.Status "paid" }}
--form[align=left]--
type="action" value="/admin/orderstatusto/{{.Order.User}}/{{.Order.ID}}/shipped"
type="submit" label="Mark as shipped" style="primary" confirm="Mark order #{{ .Order.ID.Num }} as shipped? The buyer is told."
--/form--
{{ end }}
--form[align=left]--
type="action" value="/admin/orderstatusto/{{.Order.User}}/{{.Order.ID}}/completed"
type="submit" label="Mark as completed" confirm="Mark order #{{ .Order.ID.Num }} as completed? That is the end of it."
--/form--

--form[align=left]--
type="action" value="/admin/orderstatusto/{{.Order.User}}/{{.Order.ID}}/canceled"
type="submit" label="Cancel this order" style="danger" confirm="Cancel order #{{ .Order.ID.Num }}? The buyer is told, and there is no undo."
--/form--

{{ end -}}
## Messages

